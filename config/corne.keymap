#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        th: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";

        Config_Layer_5 {
            bindings = <&mo 5>;
            key-positions = <38 39>;
        };

        Combo_Macro_M10 {
            bindings = <&Macro_M10>;
            key-positions = <1 25>;
            layers = <2>;
        };

        Combo_Macro_M11 {
            bindings = <&Macro_M11>;
            key-positions = <26 2>;
            layers = <2>;
        };

        Combo_Macro_M12 {
            bindings = <&Macro_M12>;
            key-positions = <33 9>;
            layers = <1>;
        };

        Combo_Macro_M13 {
            bindings = <&Macro_M13>;
            key-positions = <10 34>;
            layers = <1>;
        };

        Combo_BrightUp_1 {
            bindings = <&kp F15>;
            key-positions = <6 18>;
            layers = <0>;
        };

        Combo_BrightDown_1 {
            bindings = <&kp F14>;
            key-positions = <30 18>;
            layers = <0>;
        };

        Combo_BrightUp_2 {
            bindings = <&kp C_BRI_UP>;
            key-positions = <6 18>;
            layers = <1>;
        };

        Combo_BrightDown_2 {
            bindings = <&kp C_BRI_DN>;
            key-positions = <30 18>;
            layers = <1>;
        };

        Combo_VolUp {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 17>;
            layers = <0>;
        };

        Combo_VolDown {
            bindings = <&kp C_VOL_DN>;
            key-positions = <29 17>;
            layers = <0>;
        };

        Combo_Unlock {
            bindings = <&studio_unlock>;
            key-positions = <10 1>;
            layers = <5>;
        };
    };

    macros {
        Macro_M10: Macro_M10 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M10";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp T &kp I &kp LS(A) &kp STAR &kp AMPS &kp N0 &kp E &kp N5 &kp N6 &kp U &kp UNDER &kp LS(H) &kp S &kp LS(D) &kp D &kp LS(D) &kp N5>;
        };

        Macro_M11: Macro_M11 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M11";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp N9 &kp LS(P) &kp N0 &kp LS(S) &kp UNDER &kp N1 &kp E &kp U &kp LS(W) &kp COMMA &kp L &kp R &kp LS(U) &kp MINUS &kp UNDER &kp LS(N) &kp E>;
        };

        Macro_M12: Macro_M12 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M12";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp N &kp N5 &kp MINUS &kp E &kp A &kp N7 &kp POUND &kp MINUS &kp N8 &kp F &kp N &kp POUND &kp MINUS &kp N4 &kp I &kp DLLR &kp POUND>;
        };

        Macro_M13: Macro_M13 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M13";
            #binding-cells = <0>;
            bindings = <&kp LS(J) &kp N5 &kp LS(R) &kp UNDER &kp N3 &kp LS(T) &kp N5 &kp UNDER &kp N5 &kp N1 &kp N4 &kp N6 &kp N3 &kp N2 &kp N2 &kp N8 &kp N1 &kp N5>;
        };

        Macro_SSMS_Comment: Macro_SSMS_Comment {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_Comment";
            #binding-cells = <0>;
            bindings =
                <&macro_press>  <&kp LCTRL>
                <&macro_tap>    <&kp K> <&kp C>
                <&macro_release> <&kp LCTRL>;
        };

        Macro_SSMS_UnComment: Macro_SSMS_UnComment {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_UnComment";
            #binding-cells = <0>;
            bindings =
                <&macro_press>    <&kp LCTRL>
                <&macro_tap>      <&kp K &kp U>
                <&macro_release>  <&kp LCTRL>;
        };

        Macro_SSMS_Format: Macro_SSMS_Format {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_Format";
            #binding-cells = <0>;
            bindings =
                <&macro_press>    <&kp LCTRL>
                <&macro_tap>      <&kp K &kp Y>
                <&macro_release>  <&kp LCTRL>;
        };
        
        Macro_SSMS_ToggleAllOutlining_ExpandCollapseAllRegions : Macro_SSMS_ToggleAllOutlining_ExpandCollapseAllRegions {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_ToggleAllOutlining_ExpandCollapseAllRegions";
            #binding-cells = <0>;
            bindings =
                <&macro_press>   <&kp LCTRL>
                <&macro_tap>     <&kp M &kp L>
                <&macro_release> <&kp LCTRL>;
        };

        Macro_SSMS_ToggleOutliningExpansion_CurrentSection : Macro_SSMS_ToggleOutliningExpansion_CurrentSection {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_ToggleOutliningExpansion_CurrentSection";
            #binding-cells = <0>;
            bindings =
                <&macro_press>   <&kp LCTRL>
                <&macro_tap>     <&kp M &kp M>
                <&macro_release> <&kp LCTRL>;
        };
    };

    /*
            #    /
            #    &kp KP_DIVIDE
        
            #     ~
            #    Mac                       win
            #    &th RA(RIGHT_BRACKET)     RC(RIGHT_BRACKET) 
        
            #    win
            #    |                         \  
            #    &th RA(GRAVE)             LS(GRAVE) 
        
            #    Mac
            #    |                         \  
            #    &th RA(MINUS)             RA(GRAVE)

    */

    keymap {
        compatible = "zmk,keymap";
    
        Base_layer_0 {
            label = "Colemak";
            bindings = <
                &none, Q, W, F, P, B,    J, L, U, Y,   &th RA(RIGHT_BRACKET), RC(RIGHT_BRACKET), &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &mo 3, &mo 1, &skq LSHIFT,                   SPACE, &mo 2, &mo 4
            >;
        };
    
        Extend_Layer_1 {
            label = "Extend";
            bindings = <
                &none,  &th LG(Z), LC(Z),  &th LG(X), LC(X),  &th LG(C), LC(C),  &th LG(V), LC(V),  &th LG(Y), LC(Y), HOME,       PAGE_DOWN,  PAGE_UP,  END,         PRINTSCREEN, &none,
                &none,  &skq LALT,                &skq LGUI,                &skq LSHIFT,              &skq LCTRL,               BACKSPACE,           LEFT_ARROW, DOWN_ARROW, UP_ARROW, RIGHT_ARROW, ESC,         &none,
                &none,  &skq RALT,                LS(TAB),              TAB,                  &skq RCTRL,               RETURN,              DELETE,     BACKSPACE,  TAB,      INSERT,      CAPS,        &none, 
                &mo 5, &none, &trans, RETURN, &mkp LCLK, &mkp RCLK
            >;
        };
    
        Symbols_Layer_2 {
            label = "Symbol";
            bindings = <
                &none,  EXCL,              AT,      HASH,                                   DOLLAR,  PRCNT,     LS(N6),     AMPS,   ASTRK,      PLUS,     &th RA(MINUS), A(GRAVE),  &none,
                &none,  BACKSLASH,        RA(N7),  &th LS(LEFT_BRACKET), LEFT_BRACKET,  LPAR,    RA(N9),    KP_SLASH,   MINUS,  RA(COMMA),  RA(DOT),  EQUAL,                       &none,
                &none,  RA(LEFT_BRACKET), RA(N8),  RIGHT_BRACKET,                          RPAR,    RA(N0),    LS(GRAVE),  UNDER,  SEMI,       COLON,    APOSTROPHE,                  &none,
                &none, &none, &trans, &none, &none, &mo 5
            >;
        };
        
        Num_Layer_3 {
            label = "Numeric";
            bindings = <
                &none,  &none,    LC(LS(LA(LEFT_GUI))),  LC(LS(LEFT_ALT)),  &none,      &none,    KP_PLUS,   N7,  N8,  N9,  KP_MULTIPLY,  &none,
                &none,  LALT,     LGUI,                  LSHIFT,           LCTRL,      &none,    KP_MINUS,  N4,  N5,  N6,  KP_DIVIDE,    &none,
                &none,  RALT,     GLOBE,                 &none,            RCTRL,      &none,    COMMA,     N1,  N2,  N3,  DOT,          &none,
                &none, &mo 5, &none, SPACE, N0, N0
            >;
        };
            
        Fn_Layer_4 {
            label = "Function";
            bindings = <
                &none,  &none,     &none,      &none,       &none,      &none,    &none,  F7,  F8,  F9,  F10,  &none,
                &none,  LALT,      LGUI,       LSHIFT,      LCTRL,      &none,    &none,  F4,  F5,  F6,  F11,  &none,
                &none,  RALT,      GLOBE,      &none,       RCTRL,      &none,    &none,  F1,  F2,  F3,  F12,  &none,
                &none, &none, &none, &none, &mo 5, &none
            >;
        };
            
        Config_Layer_5 {
            label = "Config";
            bindings = <
                &none,  &bootloader,   &bt BT_SEL 4,    &none,         &out OUT_TOG,  &none,         &none,           &none,           &none,         &none,            &none,  &none,
                &none,  &none,         &none,         &mkp RCLK,     &mkp LCLK,     &none,         &mmv MOVE_LEFT,  &mmv MOVE_DOWN,  &mmv MOVE_UP,  &mmv MOVE_RIGHT,  &none,  &none,
                &none,  &bt BT_SEL 4,  &bt BT_SEL 3,  &bt BT_SEL 2,  &bt BT_SEL 1,  &bt BT_SEL 0,  &none,           &none,           &none,         &none,            &none,  &none,
                &none, &none, &none, &none, &none, &none
            >;
        };
    };
};
