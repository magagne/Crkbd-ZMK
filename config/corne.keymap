#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        th: holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };
    };

   combos {
        
        compatible = "zmk,combos";

        Config_Layer_5 {
            bindings = <&mo 5>;
            key-positions = <38 39>;
        };

        Combo_Macro_M10 {
            bindings = <&Macro_M10>;
            key-positions = <1 25>;
            layers = <2>;
        };
        
        Combo_Macro_M11 {
            bindings = <&Macro_M11>;
            key-positions = <26 2>;
            layers = <2>;
        };

        Combo_Macro_M12 {
            bindings = <&Macro_M12>;
            key-positions = <33 9>;
            layers = <1>;
        };

        Combo_Macro_M13 {
            bindings = <&Macro_M13>;
            key-positions = <10 34>;
            layers = <1>;
        };

        Combo_BrightUp_1 {
            bindings = <&kp F15>;
            key-positions = <6 18>;
            layers = <0>;
        };

        Combo_BrightDown_1 {
            bindings = <&kp F14>;
            key-positions = <30 18>;
            layers = <0>;
        };

        Combo_BrightUp_2 {
            bindings = <&kp C_BRI_UP>;
            key-positions = <6 18>;
            layers = <1>;
        };

        Combo_BrightDown_2 {
            bindings = <&kp C_BRI_DN>;
            key-positions = <30 18>;
            layers = <1>;
        };

        Combo_VolUp {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 17>;
            layers = <0>;
        };

        Combo_VolDown {
            bindings = <&kp C_VOL_DN>;
            key-positions = <29 17>;
            layers = <0>;
        };

        Combo_Unlock {
            bindings = <&studio_unlock>;
            key-positions = <10 1>;
            layers = <5>;
        };
    }; 

    macros {

        Macro_M0_SSMS_Outline_ToggleCurrent: Macro_SSMS_Outline_ToggleCurrent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp M &kp M>,
                <&macro_release &kp LCTRL>;
        };
    
        Macro_M1_SSMS_Outline_ToggleAll: Macro_SSMS_Outline_ToggleAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp M &kp L>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M2_SSMS_Outline_CollapseAll: Macro_SSMS_Outline_CollapseAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp M &kp A>,
                <&macro_release &kp LCTRL>;
        };        

        Macro_M3_SSMS_Outline_HideSelection: Macro_SSMS_Outline_HideSelection {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp M &kp H>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M4_SSMS_Outline_CollapseToDef: Macro_SSMS_Outline_CollapseToDef {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp M &kp O>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M5_SSMS_Bookmark_Toggle: Macro_SSMS_Bookmark_Toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp K &kp K>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M6_SSMS_Bookmark_Next: Macro_SSMS_Bookmark_Next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp K &kp N>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M7_SSMS_Bookmark_Previous: Macro_SSMS_Bookmark_Previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp K &kp P>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M8_SSMS_Comment: Macro_SSMS_Comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp K &kp C>,
                <&macro_release &kp LCTRL>;
        };

        Macro_M9_SSMS_UnComment: Macro_SSMS_UnComment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp K &kp U>,
                <&macro_release &kp LCTRL>;
        };
        
        Macro_M10: Macro_M10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp T &kp I &kp LS(A) &kp STAR &kp AMPS &kp N0 &kp E &kp N5 &kp N6 &kp U &kp UNDER &kp LS(H) &kp S &kp LS(D) &kp D &kp LS(D) &kp N5>;
        };

        Macro_M11: Macro_M11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp N9 &kp LS(P) &kp N0 &kp LS(S) &kp UNDER &kp N1 &kp E &kp U &kp LS(W) &kp COMMA &kp L &kp R &kp LS(U) &kp MINUS &kp UNDER &kp LS(N) &kp E>;
        };

        Macro_M12: Macro_M12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp N &kp N5 &kp MINUS &kp E &kp A &kp N7 &kp POUND &kp MINUS &kp N8 &kp F &kp N &kp POUND &kp MINUS &kp N4 &kp I &kp DLLR &kp POUND>;
        };

        Macro_M13: Macro_M13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(J) &kp N5 &kp LS(R) &kp UNDER &kp N3 &kp LS(T) &kp N5 &kp UNDER &kp N5 &kp N1 &kp N4 &kp N6 &kp N3 &kp N2 &kp N2 &kp N8 &kp N1 &kp N5>;
        };
    };

    /*

        /
        &kp KP_DIVIDE

         ~
        Mac                       win
        &th RA(RIGHT_BRACKET)     RC(RIGHT_BRACKET) 

        win
        |                         \  
        &th RA(GRAVE)             LS(GRAVE) 

        Mac
        |                         \  
        &th RA(MINUS)             RA(GRAVE)

    */

    keymap {
        compatible = "zmk,keymap";

        Base_layer_0 {
            label = "Colemak";
            bindings = <
                &none &kp Q     &kp W  &kp F  &kp P  &kp B  &kp J      &kp L  &kp U      &kp Y    &th RA(RIGHT_BRACKET) RC(RIGHT_BRACKET)  &none
                &none &kp A     &kp R  &kp S  &kp T  &kp G  &kp M      &kp N  &kp E      &kp I    &kp O                                    &none
                &none &kp Z     &kp X  &kp C  &kp D  &kp V  &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH                                 &none
                                &mo 3  &mo 1  &skq LSHIFT   &kp SPACE  &mo 2  &mo 4
            >;
        };

        Extend_Layer_1 {
            label = "Extend";
            bindings = <
                &th LC(LA(LS(LG(N8)))) LC(LA(LS(LG(N7))))  &th LG(Z) LC(Z)  &th LG(X) LC(X) &th LG(C) LC(C)  &th LG(V) LC(V)  &th LG(Y) LC(Y)    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp PRINTSCREEN  &th LC(LA(LS(LG(KP_PLUS)))) LC(LA(LS(LG(N9))))
                &th LC(LA(LS(LG(N5)))) LC(LA(LS(LG(N4))))  &skq LALT        &skq LGUI       &skq LSHIFT      &skq LCTRL       &kp BACKSPACE      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ESC          &th LC(LA(LS(LG(KP_MINUS)))) LC(LA(LS(LG(N6))))
                &th LC(LA(LS(LG(N2)))) LC(LA(LS(LG(N1))))  &skq RALT        &kp LS(TAB)     &kp TAB          &skq RCTRL       &kp RETURN         &kp DELETE      &kp BACKSPACE   &kp TAB       &kp INSERT       &kp CAPS         &th LC(LA(LS(LG(N0)))) LC(LA(LS(LG(N3))))
                                                                                            &mo 5            &none            &trans             &kp RETURN      &mkp LCLK       &mkp RCLK
            >;
        };

        Symbols_Layer_2 {
            label = "Symbol";
            bindings = <
                &th LC(LA(LS(LG(N8)))) LC(LA(LS(LG(N7))))  &kp EXCL              &kp AT      &kp HASH                           &kp DOLLAR  &kp PRCNT   &kp LS(N6)     &kp AMPS   &kp ASTRK      &kp PLUS      &th RA(MINUS) RA(GRAVE)  &th LC(LA(LS(LG(KP_PLUS)))) LC(LA(LS(LG(N9))))
                &th LC(LA(LS(LG(N5)))) LC(LA(LS(LG(N4))))  &kp BACKSLASH         &kp RA(N7)  &th LS(LEFT_BRACKET) LEFT_BRACKET  &kp LPAR    &kp RA(N9)  &kp KP_SLASH   &kp MINUS  &kp RA(COMMA)  &kp COLON     &kp EQUAL                &th LC(LA(LS(LG(KP_MINUS)))) LC(LA(LS(LG(N6))))
                &th LC(LA(LS(LG(N2)))) LC(LA(LS(LG(N1))))  &kp RA(LEFT_BRACKET)  &kp RA(N8)  &kp RIGHT_BRACKET                  &kp RPAR    &kp RA(N0)  &kp LS(GRAVE)  &kp UNDER  &kp RA(DOT)    &kp SEMI      &kp APOSTROPHE           &th LC(LA(LS(LG(N0)))) LC(LA(LS(LG(N3))))
                                                                                             &none                              &none       &trans      &none          &none      &mo 5
            >;
        };
        
        Num_Layer_3 {
            label = "Numeric";
            bindings = <
                &th LC(LA(LS(LG(N8)))) LC(LA(LS(LG(N7))))  &none     &kp LC(LS(LA(LEFT_GUI)))   &kp LC(LS(LEFT_ALT))  &none      &none    &kp KP_PLUS   &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY  &th LC(LA(LS(LG(KP_PLUS)))) LC(LA(LS(LG(N9))))
                &th LC(LA(LS(LG(N5)))) LC(LA(LS(LG(N4))))  &kp LALT  &kp LGUI                   &kp LSHIFT            &kp LCTRL  &none    &kp KP_MINUS  &kp N4  &kp N5  &kp N6  &kp KP_DIVIDE    &th LC(LA(LS(LG(KP_MINUS)))) LC(LA(LS(LG(N6))))
                &th LC(LA(LS(LG(N2)))) LC(LA(LS(LG(N1))))  &kp RALT  &kp GLOBE                  &none                 &kp RCTRL  &none    &kp COMMA     &kp N1  &kp N2  &kp N3  &kp DOT          &th LC(LA(LS(LG(N0)))) LC(LA(LS(LG(N3))))
                                                                                                &none                 &mo 5      &none    &kp SPACE     &kp N0  &kp N0
            >;
        };

        Fn_Layer_4 {
            label = "Function";
            bindings = <
                &th LC(LA(LS(LG(N8)))) LC(LA(LS(LG(N7))))  &none     &none      &none       &none      &none    &none  &kp F7  &kp F8  &kp F9  &kp F10  &th LC(LA(LS(LG(KP_PLUS)))) LC(LA(LS(LG(N9))))
                &th LC(LA(LS(LG(N5)))) LC(LA(LS(LG(N4))))  &kp LALT  &kp LGUI   &kp LSHIFT  &kp LCTRL  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11  &th LC(LA(LS(LG(KP_MINUS)))) LC(LA(LS(LG(N6))))
                &th LC(LA(LS(LG(N2)))) LC(LA(LS(LG(N1))))  &kp RALT  &kp GLOBE  &none       &kp RCTRL  &none    &none  &kp F1  &kp F2  &kp F3  &kp F12  &th LC(LA(LS(LG(N0)))) LC(LA(LS(LG(N3))))
                                                                                &none       &none      &none    &none  &mo 5   &none
            >;
        };

        Config_Layer_5 {
            label = "Config";
            bindings = <
                &none  &bootloader   &bt BT_CLR    &none         &out OUT_TOG  &none           &none           &none           &none         &none            &none  &none
                &none  &none         &none         &mkp RCLK     &mkp LCLK     &none           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
                &none  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &none           &none           &none         &none            &none  &none
                                                   &none         &none         &none           &none           &none           &none
            >;
        };
    };
};