#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/behaviors.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                Q, W, F, P, G, J, L, U, Y,
                A, S, D, F, H, N, E, I, O,
                Z, X, C, V, K, M, COMMA, DOT, MINUS,
                TG(1), SPACE, ENT, BKSP
            >;
        };

        layer1 {
            bindings = <
                F1, F2, F3, F4, F5, F6, F7, F8, F9,
                F10, F11, F12, PAUS, SLCK, TRSC,
                INS, HOME, PGUP, DEL, END, PGDN,
                TG(2), SPACE, ENT, BKSP
            >;
        };
    };
};
