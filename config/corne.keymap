#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
   
    keymap {
        compatible = "zmk,keymap";

        Base_layer_0 {
            label = "Colemak";
            bindings = <
                &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
    
        Extend_Layer_1 {
            label = "Extend";
            bindings = <
                  &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
    
        Symbols_Layer_2 {
            label = "Symbol";
            bindings = <
               &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
        
        Num_Layer_3 {
            label = "Numeric";
            bindings = <
                &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
           
        Fn_Layer_4 {
            label = "Function";
            bindings = <
                 &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
            
        Config_Layer_5 {
            label = "Config";
            bindings = <
               &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
    };
};
