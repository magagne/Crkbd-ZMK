#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        th: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";

        Config_Layer_5 {
            bindings = <&mo 5>;
            key-positions = <38 39>;
        };

        Combo_Macro_M10 {
            bindings = <&Macro_M10>;
            key-positions = <1 25>;
            layers = <2>;
        };

        Combo_Macro_M11 {
            bindings = <&Macro_M11>;
            key-positions = <26 2>;
            layers = <2>;
        };

        Combo_Macro_M12 {
            bindings = <&Macro_M12>;
            key-positions = <33 9>;
            layers = <1>;
        };

        Combo_Macro_M13 {
            bindings = <&Macro_M13>;
            key-positions = <10 34>;
            layers = <1>;
        };

        Combo_BrightUp_1 {
            bindings = <&kp F15>;
            key-positions = <6 18>;
            layers = <0>;
        };

        Combo_BrightDown_1 {
            bindings = <&kp F14>;
            key-positions = <30 18>;
            layers = <0>;
        };

        Combo_BrightUp_2 {
            bindings = <&kp C_BRI_UP>;
            key-positions = <6 18>;
            layers = <1>;
        };

        Combo_BrightDown_2 {
            bindings = <&kp C_BRI_DN>;
            key-positions = <30 18>;
            layers = <1>;
        };

        Combo_VolUp {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 17>;
            layers = <0>;
        };

        Combo_VolDown {
            bindings = <&kp C_VOL_DN>;
            key-positions = <29 17>;
            layers = <0>;
        };

        Combo_Unlock {
            bindings = <&studio_unlock>;
            key-positions = <10 1>;
            layers = <5>;
        };
    };

    macros {
        Macro_M10: Macro_M10 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M10";
            #binding-cells = <0>;
            bindings = <&kp LS(K), &kp T, &kp I, &kp LS(A), &kp STAR, &kp N0, &kp N0, &kp E, &kp N5, &kp N6, &kp U, &kp UNDER, &kp LS(H), &kp S, &kp LS(D), &kp D, &kp LS(D), &kp N5>;
        };

        Macro_M11: Macro_M11 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M11";
            #binding-cells = <0>;
            bindings = <&kp AMPS, &kp N9, &kp LS(P), &kp N0, &kp LS(S), &kp UNDER, &kp N1, &kp E, &kp U, &kp LS(W), &kp COMMA, &kp L, &kp R, &kp LS(U), &kp MINUS, &kp UNDER, &kp LS(N), &kp E>;
        };

        Macro_M12: Macro_M12 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M12";
            #binding-cells = <0>;
            bindings = <&kp LS(N), &kp N, &kp N5, &kp MINUS, &kp E, &kp A, &kp N7, &kp POUND, &kp MINUS, &kp N8, &kp F, &kp N, &kp POUND, &kp MINUS, &kp N4, &kp I, &kp DLLR, &kp POUND>;
        };

        Macro_M13: Macro_M13 {
            compatible = "zmk,behavior-macro";
            label = "Macro_M13";
            #binding-cells = <0>;
            bindings = <&kp LS(J), &kp N5, &kp LS(R), &kp UNDER, &kp N3, &kp LS(T), &kp N5, &kp UNDER, &kp N5, &kp N1, &kp N4, &kp N6, &kp N3, &kp N2, &kp N2, &kp N8, &kp N1, &kp N5>;
        };

        Macro_SSMS_UnComment: Macro_SSMS_UnComment {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_UnComment";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &macro_tap &kp K &kp U &macro_release &kp LCTRL>;
        };
        
        Macro_SSMS_Format: Macro_SSMS_Format {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_Format";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &macro_tap &kp K &kp Y &macro_release &kp LCTRL>;
        };
        
        Macro_SSMS_ToggleAllOutlining_ExpandCollapseAllRegions: Macro_SSMS_ToggleAllOutlining_ExpandCollapseAllRegions {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_ToggleAllOutlining_ExpandCollapseAllRegions";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &macro_tap &kp M &kp L &macro_release &kp LCTRL>;
        };
        
        Macro_SSMS_ToggleOutliningExpansion_CurrentSection: Macro_SSMS_ToggleOutliningExpansion_CurrentSection {
            compatible = "zmk,behavior-macro";
            label = "Macro_SSMS_ToggleOutliningExpansion_CurrentSection";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &macro_tap &kp M &kp M &macro_release &kp LCTRL>;
        };
    };

    /*
            #    /
            #    &kp KP_DIVIDE
        
            #     ~
            #    Mac                       win
            #    &th RA(RIGHT_BRACKET)     RC(RIGHT_BRACKET) 
        
            #    win
            #    |                         \  
            #    &th RA(GRAVE)             LS(GRAVE) 
        
            #    Mac
            #    |                         \  
            #    &th RA(MINUS)             RA(GRAVE)

    */

    keymap {
        compatible = "zmk,keymap";
    
        Base_layer_0 {
            label = "Colemak";
            bindings = <
                &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
    
        Extend_Layer_1 {
            label = "Extend";
            bindings = <
                  &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
    
        Symbols_Layer_2 {
            label = "Symbol";
            bindings = <
               &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
        
        Num_Layer_3 {
            label = "Numeric";
            bindings = <
                &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
           
        Fn_Layer_4 {
            label = "Function";
            bindings = <
                 &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
            
        Config_Layer_5 {
            label = "Config";
            bindings = <
               &none, Q, W, F, P, B,    J, L, U, Y,   &none, &none,
                &none, A, R, S, T, G,    M, N, E, I, O,                                        &none,
                &none, Z, X, C, D, V,    K, H, COMMA, DOT, FSLH,                               &none,
                &none, &none, &none,                   &none, &none,&none
            >;
        };
    };
};
