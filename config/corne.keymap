#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td: MyTapDance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        th: MyTapHold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        skq: MyStickyKeyQuickRelease {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };

        HID_DragScroll: HID_DragScroll {
            compatible = "zmk,behavior-raw-drag-scroll";
            #binding-cells = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_Macro_M10 {
            bindings = <&Macro_M10>;
            key-positions = <1 25>;
            layers = <2>;
        };

        Combo_Macro_M11 {
            bindings = <&Macro_M11>;
            key-positions = <26 2>;
            layers = <2>;
        };

        Combo_Macro_M12 {
            bindings = <&Macro_M12>;
            key-positions = <33 9>;
            layers = <1>;
        };

        Combo_Macro_M13 {
            bindings = <&Macro_M13>;
            key-positions = <10 34>;
            layers = <1>;
        };

        Combo_BrightnessUp_Mac {
            bindings = <&kp LC(LS(LA(LG(F10))))>;
            key-positions = <6 18>;
            layers = <0>;
        };

        Combo_BrightnessDown_Mac {
            bindings = <&kp LC(LS(LA(LG(F11))))>;
            key-positions = <30 18>;
            layers = <0>;
        };

        Combo_BrightnessUp_Win {
            bindings = <&kp C_BRI_UP>;
            key-positions = <6 18>;
            layers = <1>;
        };

        Combo_BrightnessDown_Win {
            bindings = <&kp C_BRI_DN>;
            key-positions = <30 18>;
            layers = <1>;
        };

        Combo_VolumeUp {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 17>;
            layers = <0>;
        };

        Combo_VolumeDown {
            bindings = <&kp C_VOL_DN>;
            key-positions = <29 17>;
            layers = <0>;
        };

        Combo_Unlock {
            bindings = <&studio_unlock>;
            key-positions = <10 1>;
            layers = <7>;
        };
    };

    macros {
        // ------------------------------------------------------------- 
        // Macro for IDE (SSMS & VisualCoed)
        // ------------------------------------------------------------- 

        Macro_M00_Outline_CollapseAll: Macro_M00_Outline_CollapseAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp M &kp A>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M01_Outline_ToggleCurrent: Macro_M01_Outline_ToggleCurrent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp M &kp M>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M02_Outline_ExpandAll: Macro_M02_Outline_ExpandAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp M &kp L>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M03_Bookmark_Previous: Macro_M03_Bookmark_Previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp P>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M04_Bookmark_Toggle: Macro_M04_Bookmark_Toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp K>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M05_Bookmark_ClearAll: Macro_M05_Bookmark_ClearAll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp L>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M06_Bookmark_Next: Macro_M06_Bookmark_Next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp N>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M07_Comment: Macro_M07_Comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp C>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        Macro_M08_UnComment: Macro_M08_UnComment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp K &kp U>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        // ------------------------------------------------------------- 
        // Password for local stuff
        // ------------------------------------------------------------- 

        Macro_M10: Macro_M10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp T &kp I &kp LS(A) &kp STAR &kp AMPS &kp N0 &kp E &kp N5 &kp N6 &kp U &kp UNDER &kp LS(H) &kp S &kp LS(D) &kp D &kp LS(D) &kp N5>;
        };

        Macro_M11: Macro_M11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp N9 &kp LS(P) &kp N0 &kp LS(S) &kp UNDER &kp N1 &kp E &kp U &kp LS(W) &kp COMMA &kp L &kp R &kp LS(U) &kp MINUS &kp UNDER &kp LS(N) &kp E>;
        };

        Macro_M12: Macro_M12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp N &kp N5 &kp MINUS &kp E &kp A &kp N7 &kp POUND &kp MINUS &kp N8 &kp F &kp N &kp POUND &kp MINUS &kp N4 &kp I &kp DLLR &kp POUND>;
        };

        Macro_M13: Macro_M13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(J) &kp N5 &kp LS(R) &kp UNDER &kp N3 &kp LS(T) &kp N5 &kp UNDER &kp N5 &kp N1 &kp N4 &kp N6 &kp N3 &kp N2 &kp N2 &kp N8 &kp N1 &kp N5>;
        };

        // ------------------------------------------------------------- 
        // Mouse
        // ------------------------------------------------------------- 

        LCLK_LCLK: LCLK_LCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &mkp LCLK>;
        };

        LED_DragScroll: LED_DragScroll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp SCROLLLOCK>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp SCROLLLOCK>;
        };
    };

    /*

        Symbol      Mac                         Win
        -------     ----------------------      ----------------------
        ~           &kp RA(RIGHT_BRACKET)       &kp RC(RIGHT_BRACKET) 
 
        /           &kp KP_DIVIDE               &kp KP_DIVIDE 
 
        \           &kp  RA(GRAVE)              &kp LS(GRAVE) 

        |           &kp  RA(MINUS)              &kp RA(GRAVE)
    */

    keymap {
        compatible = "zmk,keymap";

        Win_Base_Layout {
            label = "WinBase";
            bindings = <
&none  &kp Q  &kp W  &kp F  &kp P  &kp B         &kp J      &kp L  &kp U      &kp Y    &kp RC(RIGHT_BRACKET)   &none
&none  &kp A  &kp R  &kp S  &kp T  &kp G         &kp M      &kp N  &kp E      &kp I    &kp O              &none
&none  &kp Z  &kp X  &kp C  &kp D  &kp V         &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH           &none
                     &mo 8  &mo 2  &sk LSHIFT    &kp SPACE  &mo 4  &none
            >;
        };

        Mac_Base_Layout {
            label = "MacBase";
            bindings = <
&none  &kp Q  &kp W  &kp F  &kp P  &kp B         &kp J      &kp L  &kp U      &kp Y    &kp RA(RIGHT_BRACKET)   &none
&none  &kp A  &kp R  &kp S  &kp T  &kp G         &kp M      &kp N  &kp E      &kp I    &kp O          &none
&none  &kp Z  &kp X  &kp C  &kp D  &kp V         &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH       &none
                     &mo 8  &mo 3  &sk LSHIFT    &kp SPACE  &mo 5  &none
            >;
        };

        Win_Extend_Layout {
            label = "WinExt";
            bindings = <
&none  &kp LC(Z)  &kp LC(X)    &kp LC(C)    &kp LC(V)   &kp LC(Y)        &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp PRINTSCREEN  &none
&none  &skq LALT  &skq LGUI    &skq LSHIFT  &skq LCTRL  &kp BACKSPACE    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ESC          &none
&none  &skq RALT  &kp LS(TAB)  &kp TAB      &skq RCTRL  &kp RETURN       &kp DELETE      &kp BACKSPACE   &kp TAB       &kp INSERT       &kp CAPS         &none
                               &none        &none       &none            &kp RETURN      &mo 9           &mo 10
            >;
        };

        Mac_Extend_Layout {
            label = "MacExt";
            bindings = <
&none  &kp LG(Z)  &kp LG(X)    &kp LG(C)    &kp LG(V)   &kp LG(Y)        &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp PRINTSCREEN  &none
&none  &skq LALT  &skq LGUI    &skq LSHIFT  &skq LCTRL  &kp BACKSPACE    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ESC          &none
&none  &skq RALT  &kp LS(TAB)  &kp TAB      &skq RCTRL  &kp RETURN       &kp DELETE      &kp BACKSPACE   &kp TAB       &kp INSERT       &kp CAPS         &none
                               &none        &none       &none            &kp RETURN      &mo 9           &mo 10
            >;
        };

        Win_Symbol_Layout {
            label = "WinSym";
            bindings = <
&none  &kp EXCL              &kp AT      &kp HASH                           &kp DOLLAR  &kp PRCNT     &kp LS(N6)     &kp AMPS   &kp ASTRK      &kp PLUS   &kp RA(GRAVE)     &none
&none  &kp BACKSLASH         &kp RA(N7)  &th LS(LEFT_BRACKET) LEFT_BRACKET  &kp LPAR    &kp RA(N9)    &kp KP_DIVIDE   &kp MINUS  &kp RA(COMMA)  &kp COLON  &kp EQUAL          &none
&none  &kp RA(LEFT_BRACKET)  &kp RA(N8)  &kp RIGHT_BRACKET                  &kp RPAR    &kp RA(N0)    &kp LS(GRAVE)  &kp UNDER  &kp RA(DOT)    &kp SEMI   &kp APOSTROPHE     &none
                                         &mo 7                              &mo 6       &none         &none          &none      &none
            >;
        };

        Mac_Symbol_Layout {
            label = "MacSym";
            bindings = <
&none  &kp EXCL              &kp AT      &kp HASH                           &kp DOLLAR  &kp PRCNT     &kp LS(N6)     &kp AMPS   &kp ASTRK      &kp PLUS   &kp RA(MINUS)   &none
&none  &kp BACKSLASH         &kp RA(N7)  &th LS(LEFT_BRACKET) LEFT_BRACKET  &kp LPAR    &kp RA(N9)    &kp RA(FSLH)   &kp MINUS  &kp RA(COMMA)  &kp COLON  &kp EQUAL       &none
&none  &kp RA(LEFT_BRACKET)  &kp RA(N8)  &kp RIGHT_BRACKET                  &kp RPAR    &kp RA(N0)    &kp RA(GRAVE)  &kp UNDER  &kp RA(DOT)    &kp SEMI   &kp APOSTROPHE  &none
                                         &mo 7                              &mo 6       &none         &none          &none      &none
            >;
        };

        Num_Layout {
            label = "Num";
            bindings = <
&none  &none     &kp LC(LS(LEFT_ALT))  &kp LC(LS(LA(LEFT_GUI)))  &none      &none      &none         &kp N7  &kp N8   &kp N9  &kp LOCKING_NUM  &none
&none  &kp LALT  &kp LGUI              &kp LSHIFT                &kp LCTRL  &kp DEL    &kp KP_MINUS  &kp N4  &kp N5   &kp N6  &kp KP_DIVIDE    &none
&none  &kp RALT  &kp GLOBE             &none                     &kp RCTRL  &kp RET    &kp KP_PLUS   &kp N1  &kp N2   &kp N3  &kp KP_MULTIPLY  &none
                                       &none                     &none      &none      &kp SPACE     &kp N0  &kp DOT
            >;
        };

        Fn_Layout {
            label = "Fn";
            bindings = <
&none  &none     &none      &none       &none      &none    &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &kp LALT  &kp LGUI   &kp LSHIFT  &kp LCTRL  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &kp RALT  &kp GLOBE  &none       &kp RCTRL  &none    &none  &kp F1  &kp F2  &kp F3  &kp F12  &none
                            &none       &none      &none    &none  &none   &none
            >;
        };

        Mouse_Layout {
            label = "Mouse";
            bindings = <
&none  &none       &mkp LCLK  &LED_DragScroll  &HID_DragScroll  &kp SCROLLLOCK    &none           &none           &none           &none            &none  &none
&none  &LCLK_LCLK  &mkp MCLK  &mkp RCLK        &mkp LCLK        &none             &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none  &none
&none  &kp LALT    &kp LGUI   &kp LSHFT        &kp LCTRL        &none             &none           &msc SCRL_UP    &msc SCRL_DOWN  &none            &none  &none
                              &none            &none            &none             &none           &mkp MB4        &mkp MB5
            >;
        };

        Config_Layout {
            label = "Config";
            bindings = <
&none  &none         &none         &out OUT_USB  &out OUT_BLE  &none    &none  &none  &none  &none  &none  &none
&none  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none    &none  &none  &none  &none  &none  &none
&none  &none         &none         &to 0         &to 1         &none    &none  &none  &none  &none  &none  &none
                                   &none         &none         &none    &none  &none  &none
            >;
        };

        Reset_Layout {
            label = "Reset";
            bindings = <
&bootloader  &bootloader  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&bt BT_CLR   &bt BT_CLR   &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none        &none        &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                                 &none  &none  &none    &none  &none  &none
            >;
        };
    };
};
